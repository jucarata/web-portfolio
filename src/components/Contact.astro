---
import { channels, profile } from "../data/site";

const year = new Date().getFullYear();
const links = channels.filter((channel) => channel.href);
---

<section class="contact" id="contact" aria-labelledby="contact-title">
  <div class="wrap">
    <h2 class="section-title" id="contact-title">
      <span class="sq sq-yellow" aria-hidden="true"></span>
      Contact me
    </h2>
    <p class="contact-lead">
      For a role, a system, or a problem that needs a precise build. Reach me on the network that suits you.
    </p>
    <ul class="channels">
      {
        links.map((channel) => (
          <li>
            <a
              href={channel.href}
              {...(channel.external ? { target: "_blank", rel: "noopener noreferrer" } : {})}
            >
              <span class:list={["sq", `sq-${channel.tone}`]} aria-hidden="true" />
              <span class="channel-copy">
                <span class="channel-name">{channel.name}</span>
                <span class="quiet">{channel.handle}</span>
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
  <div class="wrap signoff">
    <p>Jucarata · {profile.name}</p>
    <p>© {year}</p>
  </div>
</section>
