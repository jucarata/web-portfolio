---
import { existsSync } from "node:fs";
import { join } from "node:path";
import { fileURLToPath } from "node:url";
import { personalProjects, professionalProjects } from "../data/site";
import { asset } from "../lib/asset";

const publicRoot = fileURLToPath(new URL("../../public/", import.meta.url));
const defaultImage = "projects/default.jpg";

function present<T extends { image: string }>(items: readonly T[]) {
  return items.map((item) => {
    const hasImage = existsSync(join(publicRoot, item.image));
    const custom = hasImage && item.image !== defaultImage;
    return {
      ...item,
      src: asset(custom ? item.image : defaultImage),
      custom,
    };
  });
}

const groups = [
  {
    id: "professional-projects",
    title: "Professional projects",
    tone: "red",
    items: present(professionalProjects),
  },
  {
    id: "personal-projects",
    title: "Personal projects",
    tone: "blue",
    items: present(personalProjects),
  },
];
---

<section class="section" id="projects" aria-labelledby="projects-title">
  <div class="wrap">
    <div class="section-head">
      <h2 class="section-title" id="projects-title">
        <span class="sq sq-blue" aria-hidden="true"></span>
        Projects
      </h2>
      <p>Systems built for organizations, and products I design on my own.</p>
    </div>

    {
      groups.map((group) => (
        <div class="project-group">
          <h3 class="subhead project-kicker" id={group.id}>
            <span class:list={["sq", `sq-${group.tone}`]} aria-hidden="true" />
            {group.title}
          </h3>
          <div class="project-grid">
            {group.items.map((item) => (
              <article class:list={["project", { "is-zoomable": item.custom }]}>
                <figure class:list={["project-media", { "is-default": !item.custom }]}>
                  <img
                    src={item.src}
                    alt={item.custom ? item.imageAlt : ""}
                    width="2600"
                    height="1000"
                  />
                </figure>
                {item.custom ? (
                  <button
                    type="button"
                    class="project-open"
                    data-src={item.src}
                    data-alt={item.imageAlt}
                    data-title={item.title}
                    aria-haspopup="dialog"
                    aria-label={`View ${item.title} image`}
                  />
                ) : null}
                <div class="project-body">
                  <p class="project-status">
                    <span class:list={["swatch", `swatch-${item.tone}`]} aria-hidden="true" />
                    <span class="flag">{item.status}</span>
                    <span class="flag">{item.privacy}</span>
                  </p>
                  <h4>{item.title}</h4>
                  <p>{item.text}</p>
                  {"repo" in item || "live" in item ? (
                    <p class="project-links">
                      {"repo" in item && item.repo ? (
                        <a href={item.repo} target="_blank" rel="noopener noreferrer">
                          Repository
                        </a>
                      ) : null}
                      {"live" in item && item.live ? (
                        <a class="project-live" href={item.live} target="_blank" rel="noopener noreferrer">
                          Live
                        </a>
                      ) : null}
                    </p>
                  ) : null}
                </div>
              </article>
            ))}
          </div>
        </div>
      ))
    }
  </div>
</section>

<dialog class="lightbox" id="project-lightbox" aria-labelledby="lightbox-title">
  <button type="button" class="lightbox-close" data-lightbox-close>Close</button>
  <div class="lightbox-stage">
    <figure class="lightbox-figure">
      <img class="lightbox-img" alt="" />
      <figcaption class="lightbox-caption" id="lightbox-title"></figcaption>
    </figure>
  </div>
</dialog>

<script>
  const dialog = document.querySelector("#project-lightbox");
  const image = dialog?.querySelector(".lightbox-img");
  const caption = dialog?.querySelector(".lightbox-caption");

  function isPlaceholder(src) {
    return src.endsWith("projects/default.jpg");
  }

  function openFrom(button) {
    if (!(dialog instanceof HTMLDialogElement) || !(image instanceof HTMLImageElement)) return;
    const src = button.dataset.src ?? "";
    if (!src || isPlaceholder(src)) return;
    image.src = src;
    image.alt = button.dataset.alt ?? "";
    if (caption) caption.textContent = button.dataset.title ?? "";
    document.body.classList.add("lightbox-open");
    dialog.showModal();
  }

  document.querySelectorAll(".project-open").forEach((button) => {
    button.addEventListener("click", () => {
      if (button instanceof HTMLButtonElement) openFrom(button);
    });
  });

  dialog?.addEventListener("click", (event) => {
    if (!(dialog instanceof HTMLDialogElement)) return;
    const target = event.target;
    if (!(target instanceof Element)) return;
    if (target.closest(".lightbox-figure")) return;
    dialog.close();
  });

  dialog?.addEventListener("close", () => {
    document.body.classList.remove("lightbox-open");
    if (image instanceof HTMLImageElement) image.removeAttribute("src");
  });
</script>
